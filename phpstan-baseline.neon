parameters:
	ignoreErrors:
		-
			message: '#^Class App\\Domain\\Participant constructor invoked with 3 parameters, 2 required\.$#'
			identifier: arguments.count
			count: 1
			path: app/Application/AddParticipantToSubscriptionHandler.php

		-
			message: '#^Access to private property App\\Domain\\Participant\:\:\$email\.$#'
			identifier: property.private
			count: 1
			path: app/Application/GetParticipantPaymentsHandler.php

		-
			message: '#^Method App\\Application\\GetSubscriptionsHandler\:\:__invoke\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Application/GetSubscriptionsHandler.php

		-
			message: '#^Access to private property App\\Domain\\Participant\:\:\$email\.$#'
			identifier: property.private
			count: 2
			path: app/Domain/Subscription.php

		-
			message: '#^Method App\\Domain\\Subscription\:\:getNextDate\(\) has DateMalformedStringException in PHPDoc @throws tag but it''s not thrown\.$#'
			identifier: throws.unusedType
			count: 1
			path: app/Domain/Subscription.php

		-
			message: '#^Access to an undefined property App\\Domain\\Participant\:\:\$id\.$#'
			identifier: property.notFound
			count: 1
			path: app/Infrastructure/SQLiteSubscriptionRepository.php

		-
			message: '#^Cannot access offset ''available_seats'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: app/Infrastructure/SQLiteSubscriptionRepository.php

		-
			message: '#^Cannot access offset ''frequency'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: app/Infrastructure/SQLiteSubscriptionRepository.php

		-
			message: '#^Cannot access offset ''id'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: app/Infrastructure/SQLiteSubscriptionRepository.php

		-
			message: '#^Cannot access offset ''price_amount'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: app/Infrastructure/SQLiteSubscriptionRepository.php

		-
			message: '#^Cannot access offset ''price_currency'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: app/Infrastructure/SQLiteSubscriptionRepository.php

		-
			message: '#^Cannot access offset ''service_name'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: app/Infrastructure/SQLiteSubscriptionRepository.php

		-
			message: '#^Cannot access offset ''subscribed_on'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: app/Infrastructure/SQLiteSubscriptionRepository.php

		-
			message: '#^Cannot call method fetchAll\(\) on PDOStatement\|false\.$#'
			identifier: method.nonObject
			count: 1
			path: app/Infrastructure/SQLiteSubscriptionRepository.php

		-
			message: '#^Cannot cast mixed to float\.$#'
			identifier: cast.double
			count: 1
			path: app/Infrastructure/SQLiteSubscriptionRepository.php

		-
			message: '#^Cannot cast mixed to int\.$#'
			identifier: cast.int
			count: 1
			path: app/Infrastructure/SQLiteSubscriptionRepository.php

		-
			message: '#^Class App\\Domain\\Participant constructor invoked with 4 parameters, 2 required\.$#'
			identifier: arguments.count
			count: 1
			path: app/Infrastructure/SQLiteSubscriptionRepository.php

		-
			message: '#^Method App\\Infrastructure\\SQLiteSubscriptionRepository\:\:findAll\(\) should return array\<App\\Domain\\Subscription\> but returns list\<App\\Domain\\Subscription\|null\>\.$#'
			identifier: return.type
			count: 1
			path: app/Infrastructure/SQLiteSubscriptionRepository.php

		-
			message: '#^Parameter \#1 \$datetime of class DateTimeImmutable constructor expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: app/Infrastructure/SQLiteSubscriptionRepository.php

		-
			message: '#^Parameter \#1 \$value of class App\\Domain\\SubscriptionId constructor expects string\|null, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: app/Infrastructure/SQLiteSubscriptionRepository.php

		-
			message: '#^Parameter \#1 \$value of static method App\\Domain\\Frequency\:\:from\(\) expects int\|string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: app/Infrastructure/SQLiteSubscriptionRepository.php

		-
			message: '#^Parameter \#2 \$currency of class App\\Domain\\Price constructor expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: app/Infrastructure/SQLiteSubscriptionRepository.php

		-
			message: '#^Parameter \#2 \$serviceName of class App\\Domain\\Subscription constructor expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: app/Infrastructure/SQLiteSubscriptionRepository.php

		-
			message: '#^Access to an undefined property App\\Domain\\Participant\:\:\$firstName\.$#'
			identifier: property.notFound
			count: 1
			path: tests/Feature/SubscriptionTest.php

		-
			message: '#^Access to private property App\\Domain\\Participant\:\:\$email\.$#'
			identifier: property.private
			count: 1
			path: tests/Feature/SubscriptionTest.php

		-
			message: '#^Cannot access offset ''2025\-01\-01'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: tests/Feature/SubscriptionTest.php

		-
			message: '#^Cannot access offset ''2025\-02\-01'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: tests/Feature/SubscriptionTest.php

		-
			message: '#^Cannot access property \$amount on mixed\.$#'
			identifier: property.nonObject
			count: 2
			path: tests/Feature/SubscriptionTest.php

		-
			message: '#^Cannot call method getResult\(\) on Symfony\\Component\\Messenger\\Stamp\\HandledStamp\|null\.$#'
			identifier: method.nonObject
			count: 1
			path: tests/Feature/SubscriptionTest.php

		-
			message: '#^Parameter \#2 \$haystack of method PHPUnit\\Framework\\Assert\:\:assertCount\(\) expects Countable\|iterable, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: tests/Feature/SubscriptionTest.php
